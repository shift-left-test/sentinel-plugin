<?jelly escape-by-default='true'?>
<!--
  Rendered on the job page via the projectActionFloatingBox taglib,
  which includes this view with st:include from="..." WITHOUT setting
  "it" - so "it" is the Job here. The action must be referenced via
  the "from" (or "action") variable.
-->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler">
  <script src="${rootURL}/plugin/echarts-api/js/echarts.min.js"
          type="text/javascript"></script>
  <st:adjunct includes="io.jenkins.plugins.sentinel.charts"/>

  <div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">
    <h3 style="font-size:14px;color:#333;margin:0 0 12px 0;">Sentinel Trend Report</h3>
    <!-- resize:both lets the user drag the corner; charts.js follows
         via ResizeObserver and remembers the size per job. The height
         must clear the legend that trendOption renders below the
         grid, so keep it in step with that function's compact grid. -->
    <div id="sentinel-trend-chart"
         data-trend="${from.trendDataJson}"
         style="width:500px;height:280px;resize:both;overflow:hidden;">
    </div>
  </div>
</j:jelly>
